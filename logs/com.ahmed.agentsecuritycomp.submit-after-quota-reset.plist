    <string>/private/tmp/agentsecurity_submit_after_quota_reset.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/private/tmp</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/ahmed</string>
